### Eduleb Project dotenv example

# Database example values
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bdd_edumatch
DB_USER=root
DB_PASSWORD=

# Mail (SMTP) example values
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=tls
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM_EMAIL=your-email@gmail.com
MAIL_FROM_NAME="EduMatch - Recrutement"
MAIL_REPLY_TO=support@edumatch.local
MAIL_DEBUG=false

# reCAPTCHA v2 example values
RECAPTCHA_SITE_KEY=your-site-key
RECAPTCHA_SECRET_KEY=your-secret-key
RECAPTCHA_VERIFY_URL=https://www.google.com/recaptcha/api/siteverify
RECAPTCHA_TIMEOUT=5
RECAPTCHA_ENABLED=true

# AI match scoring example values
AI_ENABLED=true
AI_PROVIDER=groq
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=your-real-groq-api-key
AI_MODEL=llama-3.3-70b-versatile
AI_TEMPERATURE=0.2
AI_TIMEOUT=45
AI_RESPONSE_FORMAT=json_object
AI_MAX_CV_CHARS=12000
AI_MAX_OFFER_CHARS=6000
AI_FALLBACK_ENABLED=false

# Guidance:
# - Do not commit real secrets.
# - Keep your real values in .env (ignored by git).