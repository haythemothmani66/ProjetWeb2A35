### Eduleb Project dotenv example

# Mail (SMTP) example values
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=tls
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM_EMAIL=your-email@gmail.com
MAIL_FROM_NAME="EduMatch - Recrutement"
MAIL_REPLY_TO=support@edumatch.local
MAIL_DEBUG=false

# reCAPTCHA v2 example values
RECAPTCHA_SITE_KEY=your-site-key
RECAPTCHA_SECRET_KEY=your-secret-key
RECAPTCHA_VERIFY_URL=https://www.google.com/recaptcha/api/siteverify
RECAPTCHA_TIMEOUT=5
RECAPTCHA_ENABLED=true

# Guidance:
# - Do not commit real secrets. Use config/mail.local.php and
#   config/recaptcha.local.php for PHP-based local overrides, or
#   load the .env file with a dotenv library if you change code to use it.