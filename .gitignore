# Uploads (user photos — ignore all except default.png)
uploads/photos/*.jpg
uploads/photos/*.jpeg
uploads/photos/*.png
!uploads/photos/default.png
!uploads/photos/.gitkeep

# Uploads CV candidatures (fichiers utilisateurs, ne pas versionner)
uploads/cv/*.pdf
uploads/cv/*.doc
uploads/cv/*.docx
!uploads/cv/.gitkeep

# Uploads images cours (generees par admin)
uploads/courses/*.jpg
uploads/courses/*.jpeg
uploads/courses/*.png
!uploads/courses/.gitkeep

# Environment variables (API keys)
.env

# Config sensibles (cles API personnelles - voir .example pour template)
config/recaptcha.php

# Temp files
*.txt
*.log
_test_*.php

# OS files
Thumbs.db
.DS_Store
