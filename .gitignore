# Uploads (user photos — ignore all except default.png et avatars demo encadrants)
uploads/photos/*.jpg
uploads/photos/*.jpeg
uploads/photos/*.png
!uploads/photos/default.png
!uploads/photos/.gitkeep
!uploads/photos/encadrant_*.jpg

# Uploads CV candidatures (fichiers utilisateurs, ne pas versionner)
uploads/cv/*.pdf
uploads/cv/*.doc
uploads/cv/*.docx
!uploads/cv/.gitkeep

# Uploads images cours (generees par admin)
uploads/courses/*.jpg
uploads/courses/*.jpeg
uploads/courses/*.png
!uploads/courses/.gitkeep

# Uploads devoirs (fichiers utilisateurs, ne pas versionner)
uploads/devoirs/*.pdf
uploads/devoirs/*.doc
uploads/devoirs/*.docx
uploads/devoirs/*.png
uploads/devoirs/*.jpg
uploads/devoirs/*.jpeg
!uploads/devoirs/.gitkeep

# Uploads corrections de devoirs (fichiers utilisateurs, ne pas versionner)
uploads/correction/*.pdf
uploads/correction/*.doc
uploads/correction/*.docx
uploads/correction/*.png
uploads/correction/*.jpg
uploads/correction/*.jpeg
!uploads/correction/.gitkeep

# Environment variables (API keys)
.env

# Config sensibles (cles API personnelles - voir .example pour template)
config/recaptcha.php

# Temp files
*.txt
*.log
_test_*.php

# OS files
Thumbs.db
.DS_Store
